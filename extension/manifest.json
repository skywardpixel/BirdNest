{
  "manifest_version": 3,
  "name": "BirdNest",
  "version": "0.1.0",
  "description": "Save or copy videos and GIFs from X.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BirdNest",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "key": "",
  "commands": {
    "grab-copy": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Copy hovered video/GIF with BirdNest"
    },
    "grab-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save hovered video/GIF with BirdNest"
    }
  }
}
